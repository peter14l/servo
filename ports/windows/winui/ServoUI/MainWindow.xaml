<Window
    x:Class="ServoUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ServoUI"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    Title="Servo">

    <Window.SystemBackdrop>
        <media:MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Loaded="RootLoaded" KeyDown="RootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: Mica Alt shows through the transparent background. -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Height="40"
              Background="Transparent" Padding="8,0,0,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="VerticalTabsToggle" Grid.Column="0" Width="34" Height="30"
                    Click="VerticalTabsToggleClicked" ToolTipService.ToolTip="Vertical tabs"
                    Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE8FD;" FontSize="15"/>
            </Button>

            <muxc:TabView x:Name="Tabs" Grid.Column="1" VerticalAlignment="Stretch"
                          SelectionChanged="TabsSelectionChanged"
                          TabCloseRequested="TabsTabCloseRequested"
                          IsAddTabButtonVisible="False"/>
            <Button x:Name="AddTabButton" Grid.Column="2" Width="34" Height="30" Click="AddTabClicked"
                    ToolTipService.ToolTip="New tab (Ctrl+T)" Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE710;" FontSize="14"/>
            </Button>
        </Grid>

        <!-- Navigation toolbar -->
        <Grid Grid.Row="1" Height="46" Padding="10,0,10,0" ColumnSpacing="6"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Width="34" Click="BackClicked" ToolTipService.ToolTip="Back (Alt+Left)"
                    Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72B;" FontSize="16"/>
            </Button>
            <Button Grid.Column="1" Width="34" Click="ForwardClicked" ToolTipService.ToolTip="Forward (Alt+Right)"
                    Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72A;" FontSize="16"/>
            </Button>
            <Button Grid.Column="2" Width="34" Click="ReloadClicked" ToolTipService.ToolTip="Reload (F5)"
                    Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE72C;" FontSize="16"/>
            </Button>
            <Button Grid.Column="3" Width="34" Click="HomeClicked" ToolTipService.ToolTip="Home"
                    Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE80F;" FontSize="16"/>
            </Button>

            <TextBox x:Name="Omnibox" Grid.Column="4" VerticalAlignment="Center"
                     PlaceholderText="Search or enter web address" KeyDown="OmniboxKeyDown"
                     FontSize="14" MinWidth="120"/>

            <TextBlock x:Name="StatusText" Grid.Column="5" VerticalAlignment="Center"
                       MaxWidth="180" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>

            <Button Grid.Column="6" Width="34" Click="FindOpenClicked" ToolTipService.ToolTip="Find on page (Ctrl+F)"
                    Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE721;" FontSize="16"/>
            </Button>
            <Button Grid.Column="7" Width="34" Click="SettingsClicked" ToolTipService.ToolTip="Settings"
                    Background="Transparent" BorderThickness="0">
                <FontIcon Glyph="&#xE713;" FontSize="16"/>
            </Button>
        </Grid>

        <!-- Find on page. It lives in its own row because XAML overlays cannot
             paint above the native Servo child HWND. -->
        <Grid x:Name="FindPanel" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,8,16,0" Padding="10,6,6,6" Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" BorderThickness="1" CornerRadius="6"
              ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FindBox" Grid.Column="0" PlaceholderText="Find on page"
                     KeyDown="FindBoxKeyDown"/>
            <Button Grid.Column="1" Width="30" Click="FindCloseClicked" Background="Transparent"
                    BorderThickness="0" ToolTipService.ToolTip="Close">
                <FontIcon Glyph="&#xE711;" FontSize="12"/>
            </Button>
        </Grid>

        <!-- Servo's HWND is a native child of the XAML window placed over this region. -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="VerticalTabsColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="VerticalTabsPanel" Grid.Column="0" Visibility="Collapsed"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" BorderThickness="0,0,1,0">
                <ListView x:Name="VerticalTabsList" SelectionMode="Single"
                          SelectionChanged="VerticalTabsSelectionChanged"
                          Background="Transparent" Padding="6"/>
            </Border>

            <Border x:Name="ViewportArea" Grid.Column="1" Background="Transparent"
                    SizeChanged="ViewportSizeChanged"/>
        </Grid>

        <!-- Native XAML settings pane (no HTML settings page). -->
        <Grid x:Name="SettingsPanel" Grid.RowSpan="4" Visibility="Collapsed" Padding="28"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Manage how Servo Browser looks, searches, and protects your data."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Width="34" Click="SettingsCloseClicked" Background="Transparent"
                        BorderThickness="0" ToolTipService.ToolTip="Close">
                    <FontIcon Glyph="&#xE711;" FontSize="12"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled">
                <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,24,24">
                    <Border Padding="20" CornerRadius="8"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Start, home, and new tabs" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Default search engine" FontSize="13"/>
                            <ComboBox x:Name="SettingSearchEngine" Width="280" SelectedIndex="0">
                                <ComboBoxItem Content="DuckDuckGo"/>
                                <ComboBoxItem Content="Google"/>
                                <ComboBoxItem Content="Bing"/>
                                <ComboBoxItem Content="Brave"/>
                            </ComboBox>
                            <TextBlock Text="Home page" FontSize="13" Margin="0,6,0,0"/>
                            <TextBox x:Name="SettingHomePage" Width="520"
                                     PlaceholderText="https://servo.org"/>
                            <TextBlock Text="Download folder" FontSize="13" Margin="0,6,0,0"/>
                            <TextBox x:Name="SettingDownloadDir" Width="520"
                                     PlaceholderText="Downloads"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="20" CornerRadius="8"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Theme" FontSize="13"/>
                            <ComboBox x:Name="SettingTheme" Width="280" SelectedIndex="2">
                                <ComboBoxItem Content="Light"/>
                                <ComboBoxItem Content="Dark"/>
                                <ComboBoxItem Content="System default"/>
                            </ComboBox>
                            <TextBlock Text="Window backdrop (applies after restart)" FontSize="13" Margin="0,6,0,0"/>
                            <ComboBox x:Name="SettingBackdrop" Width="280" SelectedIndex="0">
                                <ComboBoxItem Content="Mica Alt"/>
                                <ComboBoxItem Content="Mica"/>
                                <ComboBoxItem Content="Solid"/>
                            </ComboBox>
                            <muxc:ToggleSwitch x:Name="SettingVerticalTabs" Header="Vertical tabs"
                                               OnContent="On" OffContent="Off" Margin="0,6,0,0"/>
                            <muxc:ToggleSwitch x:Name="SettingSuggestions" Header="Search suggestions in the address bar"
                                               OnContent="On" OffContent="Off"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="20" CornerRadius="8"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Privacy and services" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="User agent (applies after restart)" FontSize="13"/>
                            <ComboBox x:Name="SettingUserAgent" Width="420" SelectedIndex="0">
                                <ComboBoxItem Content="Firefox 132 (Desktop) [Recommended]"/>
                                <ComboBoxItem Content="Chrome 131 (Desktop)"/>
                                <ComboBoxItem Content="Safari 18 (macOS)"/>
                            </ComboBox>
                            <muxc:ToggleSwitch x:Name="SettingNotifications" Header="Notifications"
                                               OnContent="Allowed" OffContent="Blocked" Margin="0,6,0,0"/>
                            <muxc:ToggleSwitch x:Name="SettingGeolocation" Header="Geolocation"
                                               OnContent="Allowed" OffContent="Blocked"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="20" CornerRadius="8"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Web experiments" FontSize="17" FontWeight="SemiBold"/>
                            <muxc:ToggleSwitch x:Name="SettingWebGL2" Header="WebGL 2"
                                               OnContent="On" OffContent="Off"/>
                            <muxc:ToggleSwitch x:Name="SettingWebGPU" Header="WebGPU (experimental)"
                                               OnContent="On" OffContent="Off"/>
                            <muxc:ToggleSwitch x:Name="SettingIndexedDB" Header="IndexedDB"
                                               OnContent="On" OffContent="Off"/>
                            <muxc:ToggleSwitch x:Name="SettingWebRTC" Header="WebRTC"
                                               OnContent="On" OffContent="Off"/>
                            <muxc:ToggleSwitch x:Name="SettingVariableFonts" Header="Variable fonts"
                                               OnContent="On" OffContent="Off"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="20" CornerRadius="8"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Data and reset" FontSize="17" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="SettingClearHistory" Content="Clear browsing history"
                                        Click="ClearHistoryClicked"/>
                                <Button x:Name="SettingReset" Content="Restore default settings"
                                        Click="ResetSettingsClicked"/>
                            </StackPanel>
                            <TextBlock Text="History is stored locally on this device only."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Padding="20" CornerRadius="8"
                            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="About Servo Browser" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Native Windows shell powered by the Servo engine."
                                       FontSize="13"/>
                            <TextBlock Text="Changes are saved automatically when you close this pane."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
