<Window
    x:Class="ServoBrowser.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Native Mica Alt Titlebar + TabView -->
        <muxc:TabView
            x:Name="BrowserTabView"
            Grid.Row="0"
            Padding="8,4,0,0"
            TabWidthMode="Equal"
            CanDragTabs="True"
            CanReorderTabs="True"
            IsAddTabButtonVisible="True"
            AddTabButtonClick="OnAddTabButtonClick"
            TabCloseRequested="OnTabCloseRequested"
            SelectionChanged="OnTabSelectionChanged">
            <muxc:TabView.TabStripFooter>
                <Grid x:Name="TitleBarDragRegion" Background="Transparent" MinWidth="160" HorizontalAlignment="Stretch" />
            </muxc:TabView.TabStripFooter>
        </muxc:TabView>

        <!-- Row 1: Fluent Navigation & Omnibox Toolbar -->
        <Grid
            Grid.Row="1"
            Padding="10,6,10,8"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Click="OnBackClick" ToolTipService.ToolTip="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Click="OnForwardClick" ToolTipService.ToolTip="Forward">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>
            <Button x:Name="ReloadButton" Grid.Column="2" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Click="OnReloadClick" ToolTipService.ToolTip="Reload">
                <FontIcon x:Name="ReloadIcon" Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <Button x:Name="HomeButton" Grid.Column="3" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Click="OnHomeClick" ToolTipService.ToolTip="Home">
                <FontIcon Glyph="&#xE80F;" FontSize="14" />
            </Button>

            <!-- Omnibox -->
            <AutoSuggestBox
                x:Name="Omnibox"
                Grid.Column="4"
                Margin="4,0"
                VerticalAlignment="Center"
                PlaceholderText="Search DuckDuckGo or enter web address"
                QuerySubmitted="OnOmniboxQuerySubmitted"
                TextChanged="OnOmniboxTextChanged"
                GotFocus="OnOmniboxGotFocus">
                <AutoSuggestBox.QueryIcon>
                    <FontIcon Glyph="&#xE721;" FontSize="13" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>

            <Button x:Name="BookmarkButton" Grid.Column="5" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Click="OnBookmarkClick" ToolTipService.ToolTip="Bookmark this page">
                <FontIcon x:Name="BookmarkIcon" Glyph="&#xE734;" FontSize="14" />
            </Button>
            <Button x:Name="LibraryButton" Grid.Column="6" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Click="OnLibraryClick" ToolTipService.ToolTip="Bookmarks &amp; History (Ctrl+H)">
                <FontIcon Glyph="&#xE81C;" FontSize="14" />
            </Button>
            <Button x:Name="FindButton" Grid.Column="7" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Click="OnToggleFindClick" ToolTipService.ToolTip="Find in page (Ctrl+F)">
                <FontIcon Glyph="&#xE721;" FontSize="14" />
            </Button>
            <Button x:Name="ZoomButton" Grid.Column="8" Height="34" Padding="8,0" Background="Transparent" BorderThickness="0" CornerRadius="6" Click="OnResetZoomClick" ToolTipService.ToolTip="Reset zoom (Ctrl+0)">
                <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="12" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="SettingsButton" Grid.Column="9" Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Click="OnSettingsClick" ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>

            <muxc:ProgressBar
                x:Name="LoadProgressBar"
                Grid.ColumnSpan="10"
                VerticalAlignment="Bottom"
                Margin="-10,0,-10,-8"
                Height="2"
                IsIndeterminate="True"
                Visibility="Collapsed" />
        </Grid>

        <!-- Row 2: Collapsible Fluent Find Bar -->
        <Grid
            x:Name="FindBar"
            Grid.Row="2"
            Visibility="Collapsed"
            Padding="12,6"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="FindTextBox" Grid.Column="0" PlaceholderText="Find in page..." KeyDown="OnFindTextBoxKeyDown" />
            <TextBlock x:Name="FindCountLabel" Grid.Column="1" VerticalAlignment="Center" Margin="4,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="2" Width="32" Height="32" Padding="0" Click="OnFindPrevClick" ToolTipService.ToolTip="Previous">
                <FontIcon Glyph="&#xE70E;" FontSize="12" />
            </Button>
            <Button Grid.Column="3" Width="32" Height="32" Padding="0" Click="OnFindNextClick" ToolTipService.ToolTip="Next">
                <FontIcon Glyph="&#xE70D;" FontSize="12" />
            </Button>
            <Button Grid.Column="5" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="OnCloseFindClick" ToolTipService.ToolTip="Close">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <!-- Row 3: Native Servo Child HWND Viewport Container -->
        <Grid x:Name="ViewportPlaceholder" Grid.Row="3" Background="Transparent" SizeChanged="OnViewportSizeChanged" />
    </Grid>
</Window>
